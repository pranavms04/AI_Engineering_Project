# Copy to .env and change what you need. Never commit .env.
# Every value below is the default used when the variable is not set.
# The app reads real environment variables; load this file with: set -a; source .env; set +a

# Where the local Ollama server listens.
OLLAMA_URL=http://localhost:11434
# Model name as shown by `ollama list`. Pull it first: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
# How many chunks to retrieve and put in the prompt.
TOP_K=4
# If the best retrieval score (cosine similarity, 0-1) is below this, abstain without calling the LLM.
MIN_SCORE=0.30
# Seconds to wait for the LLM before giving up (first call is slow while the model loads).
LLM_TIMEOUT_S=120
# Lower = more deterministic answers.
TEMPERATURE=0.1
# Where build_index saves the FAISS index and chunks.json.
INDEX_DIR=storage/index
# Folder of your .pdf / .md / .txt documents (git-ignored).
DOCS_DIR=data/sample_docs
